# Copy this file to `.env` in this folder:  cp .env.example .env
# The example scripts read it from the folder you run them in (this krauncher/).
# .env holds a real key -- it is git-ignored, never commit it.

# Your Krauncher API key. Sign up at https://krauncher.com -- new accounts get
# free credits, enough to run this fine-tune.
CAS_API_KEY=cas_your_key_here
